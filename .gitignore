# Quarto build output
/_site/
/.quarto/
*_files/
*.html
!index.html
# Quarto freeze is COMMITTED (CI renders from it without R). Do not ignore _freeze/.

# Bayesian fits: draws live in $FITS_DIR on the archive disk, never here
**/output/fits/
*.csv.gz
**/stan/*
!**/stan/*.stan
!**/stan/.gitkeep

# R
.Rhistory
.RData
.Rproj.user/
*.rds
!**/output/tables/*.rds

# nix / direnv
.direnv/
result

# OS / editors
.DS_Store
*.swp

**/*.quarto_ipynb

# Gmail OAuth credentials must never enter the repo (public). Keep them in ~/.config/gmail_sender/.
client_secret*.json
token.json
