# Quarto build output
/_site/
/.quarto/
*_files/
*.html
!index.html
# Quarto freeze is COMMITTED (CI renders from it without R). Do not ignore _freeze/.

# Bayesian fits: draws live in $FITS_DIR on the archive disk, never here
**/output/fits/
*.csv.gz
**/stan/*
!**/stan/*.stan
!**/stan/.gitkeep
# … but the small reconstructed ensemble that feeds stages 3–4 is committed (1.5 MB; draws never land there)
!**/data/derived/stage3/*.csv.gz
!**/output/tables/stage3_ensemble_per_replicate_*.csv.gz
!**/output/tables/stage3_e4_per_replicate.csv.gz
!**/output/tables/stage4_per_replicate_*.csv.gz

# R
.Rhistory
.RData
.Rproj.user/
*.rds
!**/output/tables/*.rds

# nix / direnv
.direnv/
result

# OS / editors
.DS_Store
*.swp

**/*.quarto_ipynb

# Gmail OAuth credentials must never enter the repo (public). Keep them in ~/.config/gmail_sender/.
client_secret*.json
token.json

# Raw .eml copies of received mail (optional, tools/fetch_email.py --save-eml): headers and addresses stay local
**/correspondence/eml/
__pycache__/
